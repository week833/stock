* text=auto

# Cross-platform source and documentation.
*.py text eol=lf
*.mjs text eol=lf
*.js text eol=lf
*.json text eol=lf
*.jsonl text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Windows launchers and PowerShell tools.
*.cmd text eol=crlf
*.bat text eol=crlf
*.ps1 text eol=crlf
*.psm1 text eol=crlf

# Generated or binary artifacts must never be normalized as text.
*.pdf binary
*.xlsx binary
*.xls binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.zip binary
*.pkl binary
*.joblib binary
