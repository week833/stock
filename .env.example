# Copy the current FinMind token into both keys for old and new program compatibility.
FINMIND_API_TOKEN=
FINMIND_TOKEN=
ENABLE_FINMIND_FETCH=1

ENABLE_PUBLIC_DATA_FALLBACK=1
ENABLE_YAHOO_PRICE_FALLBACK=1
ENABLE_INTRADAY_QUOTE=1
ENABLE_HISTORY_CALIBRATION=1
EXCLUDE_EMERGING=0

# Optional absolute override for the canonical shared market-data root.
STOCK_SHARED_DATA_ROOT=D:\TWStockData\shared_market_data

LOOKBACK_DAYS=420
MIN_HISTORY_TRADING_DAYS=240
RANKING_CANDIDATE_POOL=60
TOP_N=10
REPORT_DIR=reports
